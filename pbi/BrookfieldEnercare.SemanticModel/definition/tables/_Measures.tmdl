table _Measures
	hidden

	measure 'Total MRR' = CALCULATE(
			SUM(fct_billing[Amount]),
			fct_billing[TransactionType] = "MonthlyCharge",
			fct_billing[Status] = "Posted"
		)
		formatString: \$#,0.00

	measure 'New MRR' = SUMX(
			FILTER(fct_contract_month, fct_contract_month[IsNew] = 1),
			fct_contract_month[MonthlyAmount]
		)
		formatString: \$#,0.00

	measure 'Churned MRR' = SUMX(
			FILTER(fct_contract_month, fct_contract_month[IsChurn] = 1),
			fct_contract_month[MonthlyAmount]
		)
		formatString: \$#,0.00

	measure 'Net MRR Change' = [New MRR] - [Churned MRR]
		formatString: \$#,0.00

	measure 'Active Customer Count' = CALCULATE(
			COUNTROWS(dim_customer),
			dim_customer[Status] = "Active"
		)
		formatString: #,0

	measure 'Active Contract Count' = CALCULATE(
			COUNTROWS(fct_contract_month),
			fct_contract_month[ContractStatus] = "Active"
		)
		formatString: #,0

	measure 'Avg Lifetime Value' = AVERAGEX(
			dim_customer,
			CALCULATE(
				SUMX(
					FILTER(fct_billing, fct_billing[Status] = "Posted"),
					fct_billing[Amount]
				)
			)
		)
		formatString: \$#,0.00

	measure 'Avg Tenure Months' = AVERAGEX(
			dim_customer,
			DATEDIFF(dim_customer[CreatedDate], TODAY(), MONTH)
		)
		formatString: #,0

	measure 'SLA Breach Count' = SUMX(fct_service_request, fct_service_request[IsSlaBreachFlag])
		formatString: #,0

	measure 'SLA Compliance Rate' = DIVIDE(
			COUNTROWS(fct_service_request) - [SLA Breach Count],
			COUNTROWS(fct_service_request)
		)
		formatString: 0.0%

	measure 'Warranty Coverage Rate' = DIVIDE(
			SUMX(dim_equipment, dim_equipment[IsUnderWarranty]),
			COUNTROWS(dim_equipment)
		)
		formatString: 0.0%

	measure 'Avg Equipment Age Years' = AVERAGEX(
			dim_equipment,
			dim_equipment[AgeYears]
		)
		formatString: #,0.0

	partition _Measures = calculated
		mode: import
		source = ""

