table fct_contract_month
    column ContractKey
        dataType: int64
        sourceColumn: ContractKey

    column ServiceAccountKey
        dataType: int64
        sourceColumn: ServiceAccountKey

    column CustomerKey
        dataType: int64
        sourceColumn: CustomerKey

    column ProductKey
        dataType: int64
        sourceColumn: ProductKey

    column BillingMonth
        dataType: dateTime
        sourceColumn: BillingMonth
        formatString: yyyy-MM

    column BillingMonthDateKey
        dataType: int64
        sourceColumn: BillingMonthDateKey

    column ContractStartDateKey
        dataType: int64
        sourceColumn: ContractStartDateKey

    column MonthlyAmount
        dataType: double
        sourceColumn: MonthlyAmount
        formatString: \$#,0.00

    column ContractStatus
        dataType: string
        sourceColumn: ContractStatus

    column IsNew
        dataType: int64
        sourceColumn: IsNew

    column IsChurn
        dataType: int64
        sourceColumn: IsChurn

    partition fct_contract_month = entityPartition
        mode: directLake
        source
            entityName: fct_contract_month
            schemaName: dbo
            expressionSource: EnercareDemo
