table dim_service_account
    column ServiceAccountKey
        dataType: int64
        isKey: true
        sourceColumn: ServiceAccountKey

    column CustomerKey
        dataType: int64
        sourceColumn: CustomerKey

    column AccountNumber
        dataType: string
        sourceColumn: AccountNumber

    column UtilityType
        dataType: string
        sourceColumn: UtilityType

    column RateClass
        dataType: string
        sourceColumn: RateClass

    column Distributor
        dataType: string
        sourceColumn: Distributor

    column Status
        dataType: string
        sourceColumn: Status

    column ServiceAddress
        dataType: string
        sourceColumn: ServiceAddress

    column City
        dataType: string
        sourceColumn: City

    column PostalCode
        dataType: string
        sourceColumn: PostalCode

    column FSA
        dataType: string
        sourceColumn: FSA

    column OpenedDate
        dataType: dateTime
        sourceColumn: OpenedDate
        formatString: yyyy-MM-dd

    partition dim_service_account = entityPartition
        mode: directLake
        source
            entityName: dim_service_account
            schemaName: dbo
            expressionSource: EnercareDemo
