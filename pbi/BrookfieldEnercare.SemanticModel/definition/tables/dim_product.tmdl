table dim_product
    column ProductKey
        dataType: int64
        isKey: true
        sourceColumn: ProductKey

    column ProductCode
        dataType: string
        sourceColumn: ProductCode

    column ProductName
        dataType: string
        sourceColumn: ProductName

    column ProductCategory
        dataType: string
        sourceColumn: ProductCategory

    column BillingFrequency
        dataType: string
        sourceColumn: BillingFrequency

    column BasePrice
        dataType: double
        sourceColumn: BasePrice
        formatString: \$#,0.00

    column IsActive
        dataType: int64
        sourceColumn: IsActive

    column EffectiveDate
        dataType: dateTime
        sourceColumn: EffectiveDate
        formatString: yyyy-MM-dd

    partition dim_product = entityPartition
        mode: directLake
        source
            entityName: dim_product
            schemaName: dbo
            expressionSource: EnercareDemo
