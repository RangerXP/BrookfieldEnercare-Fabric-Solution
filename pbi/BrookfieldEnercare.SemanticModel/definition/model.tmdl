model Model
    culture: en-CA

    /// UPDATE: replace both GUIDs below with your actual Fabric workspace and lakehouse IDs
    /// Workspace ID : 795ce5db-7ea0-4a7c-ba64-e27c9fb568f4  (Enercare workspace)
    /// Lakehouse ID : 0ee837e4-2fd3-40d9-b228-1f167b504b7d  (lh_enercare_demo)
    datasource 'EnercareDemo' = expression
        kind: Mashup
        Value = """
            let
                Source = Lakehouse.Contents(
                    [lakeHouseId = "0ee837e4-2fd3-40d9-b228-1f167b504b7d"],
                    [workspaceId = "795ce5db-7ea0-4a7c-ba64-e27c9fb568f4"]
                )
            in
                Source
        """
